# Django
SECRET_KEY=your-django-secret-key-here
DEBUG=True
DJANGO_SETTINGS_MODULE=config.settings.development
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (development — individual fields)
DB_NAME=ar_learning_db
DB_USER=postgres
DB_PASSWORD=your-postgres-password-here
DB_HOST=localhost
DB_PORT=5432

# Database (production — single URL)
DATABASE_URL=postgres://user:password@localhost:5432/ar_learning_db

# Redis (production only)
REDIS_URL=redis://localhost:6379/0

# OpenAI (platform-level key for embeddings / moderation only)
OPENAI_API_KEY=sk-...

# Encryption key for per-user OpenAI keys
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-fernet-key-here

# Social Auth (django-allauth) — Phase 2
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
